local.file_match "hemobit" {
  path_targets = [
    {__path__ = "/var/log/hemobit/hemobit.log", application = "hemobit"},
  ]
  sync_period = "5s"
}

loki.source.file "hemobit" {
  targets    = local.file_match.hemobit.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
